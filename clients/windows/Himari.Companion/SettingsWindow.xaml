<Window x:Class="Himari.Companion.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="히마리 설정" Width="540" Height="460" MinWidth="450" MinHeight="380" WindowStartupLocation="CenterOwner" Background="#F7F7FB">
  <Grid Margin="20"><TabControl>
    <TabItem Header="연결"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
      <TextBlock Text="기기 연결" FontSize="20" FontWeight="Bold"/>
      <TextBlock x:Name="ConnectionStatus" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="#58627B"/>
      <StackPanel x:Name="PairPanel">
        <TextBlock Text="서버 HTTPS 주소"/><TextBox x:Name="ServerAddress" Text="https://" Margin="0,4,0,10"/>
        <TextBlock Text="Web에서 발급한 짝짓기 코드"/><TextBox x:Name="PairCode" Margin="0,4,0,10"/>
        <Button x:Name="PairButton" Content="기기 연결" HorizontalAlignment="Left" Padding="14,6"/>
      </StackPanel>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="ReconnectButton" Content="다시 연결" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="ChangeServerButton" Content="연결 변경" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="WebButton" Content="Web 열기" Padding="10,5"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="캐릭터"><StackPanel Margin="16">
      <TextBlock Text="캐릭터" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="히마리 · 도트 시안" Margin="0,14,0,0"/>
      <TextBlock Text="크기" Margin="0,14,0,3"/><Slider x:Name="SizeSlider" Minimum="200" Maximum="400" Value="330" TickFrequency="10"/>
      <TextBlock Text="캐릭터를 끌어 위치를 바꿀 수 있습니다." TextWrapping="Wrap" Foreground="#58627B" Margin="0,6,0,0"/>
      <CheckBox x:Name="MoveEnabled" Content="캐릭터 이동 허용" IsChecked="True" Margin="0,8,0,0"/>
      <TextBlock Text="표정 미리보기" Margin="0,18,0,4"/><ComboBox x:Name="MoodSelector" Width="170" HorizontalAlignment="Left"/>
      <Button x:Name="DemoButton" Content="가짜 대화 재생" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,0"/>
      <Button x:Name="MoveDemoButton" Content="이동 미리보기" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"/>
    </StackPanel></TabItem>
    <TabItem Header="대화 화면"><StackPanel Margin="16">
      <TextBlock Text="말풍선" FontSize="20" FontWeight="Bold"/>
      <TextBlock x:Name="BubbleDescription" TextWrapping="Wrap" Margin="0,14,0,0"/>
      <TextBlock Text="답변이 끝나면 읽을 시간을 둔 뒤 말풍선을 접습니다. 답변 영역을 펼쳐 긴 글을 스크롤할 수 있습니다." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#58627B"/>
      <TextBlock Text="단축키: Ctrl+Alt+H" Margin="0,16,0,0"/>
    </StackPanel></TabItem>
  </TabControl></Grid>
</Window>
