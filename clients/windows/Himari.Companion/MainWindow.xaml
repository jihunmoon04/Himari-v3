<Window x:Class="Himari.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Himari.Companion" Title="히마리" Width="520" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <TextBlock x:Name="Status" Text="연결되지 않음" Visibility="Collapsed"/>
    <Grid x:Name="DialogueStack" Width="304" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,50,320" TextElement.Foreground="{StaticResource BubbleInk}" TextElement.FontSize="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <local:PixelBubble x:Name="BubblePanel" Grid.Row="1" Width="280" MaxHeight="320" HorizontalAlignment="Center" TailRight="False" Visibility="Collapsed">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="ReplyContent"><local:MarkdownView x:Name="Message" FontSize="14" Foreground="{StaticResource BubbleInk}"/>
            <ContentControl x:Name="ExpandedReply" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="ReplyStatus" Grid.Row="1" Style="{StaticResource BubbleStatusText}" Margin="0,8,0,0" Visibility="Collapsed"/>
          <Border x:Name="ReplyToolbar" Grid.Row="2" Margin="-8,8,-8,-4" Padding="6,4" BorderBrush="{StaticResource BubbleSeparator}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CopyReplyButton" Style="{StaticResource BubbleIconButton}" ToolTip="답변 복사" AutomationProperties.Name="답변 복사" Click="CopyReplyClick"><local:BubbleGlyph x:Name="CopyReplyGlyph" Kind="Copy" Width="14" Height="14"/></Button>
              <Button x:Name="StopButton" Style="{StaticResource BubbleIconButton}" ToolTip="답변 멈추기" AutomationProperties.Name="답변 멈춤" Click="CancelClick" Visibility="Collapsed"><local:BubbleGlyph Kind="Stop" Width="14" Height="14"/></Button>
              <Button x:Name="ExpandButton" Style="{StaticResource BubbleIconButton}" Margin="4,0,0,0" ToolTip="말풍선 펼치기" AutomationProperties.Name="답변 확장 보기" Click="ExpandReplyClick"><local:BubbleGlyph x:Name="ExpandGlyph" Kind="Expand" Width="14" Height="14"/></Button>
            </StackPanel>
          </Border>
        </Grid>
      </local:PixelBubble>
      <local:PixelBubble x:Name="UserBubble" Width="280" MaxHeight="260" HorizontalAlignment="Center" IsUser="True" TailRight="True" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock x:Name="UserSent" TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0" Visibility="Collapsed"/>
          <StackPanel x:Name="ComposerPanel" Visibility="Collapsed">
            <Expander x:Name="ChatTools" Header="대화 선택" Visibility="Collapsed" Margin="0,0,0,6"><DockPanel><Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="새 대화" Click="NewConversationClick"/><ComboBox x:Name="Conversations" DisplayMemberPath="Title" SelectionChanged="ConversationChanged" AutomationProperties.Name="대화 선택"/></DockPanel></Expander>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="ScreenSharingButton" Style="{StaticResource BubbleIconButton}" Margin="0,0,7,0" VerticalAlignment="Top" Click="ScreenSharingClick" ToolTip="화면 함께 보내기 켜짐" AutomationProperties.Name="화면 함께 보내기 켜짐"><local:BubbleGlyph x:Name="ScreenSharingIndicator" Kind="Monitor" Width="14" Height="14"/></Button>
              <Grid Grid.Column="1" MinWidth="0">
                <TextBox x:Name="Input" MaxLength="64000" MinHeight="24" MaxHeight="110" FontSize="14" TextBlock.LineHeight="22" Foreground="{StaticResource BubbleInk}" BorderThickness="0" Background="Transparent" Padding="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="InputChanged" ToolTip="Enter로 보내기 · Shift+Enter로 줄바꿈" AutomationProperties.Name="히마리에게 보낼 메시지"/>
                <TextBlock Text="메시지 입력" Foreground="{StaticResource BubbleMuted}" Opacity="0.8" VerticalAlignment="Top" Margin="0,1,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Input}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
              <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource BubbleSendButton}" Margin="7,0,0,0" VerticalAlignment="Bottom" ToolTip="보내기 · Enter" AutomationProperties.Name="보내기" Click="SendClick"><local:BubbleGlyph Kind="Send" Width="14" Height="14"/></Button>
            </Grid>
          </StackPanel>
          <Border x:Name="UserStatusPanel" BorderBrush="{StaticResource BubbleSeparator}" BorderThickness="0,1,0,0" Margin="0,7,0,0" Padding="0,7,0,0" Visibility="Collapsed" ToolTip="{Binding Text, ElementName=Status}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <local:BubbleGlyph x:Name="UserStatusGlyph" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top"/>
              <TextBlock x:Name="UserStatus" Grid.Column="1" Style="{StaticResource BubbleStatusText}"/>
              <Button x:Name="StatusActionButton" Grid.Column="2" Style="{StaticResource BubbleTextButton}" Margin="6,0,0,0" VerticalAlignment="Top" Visibility="Collapsed" Click="StatusActionClick"><TextBlock x:Name="StatusActionText" TextDecorations="Underline"/></Button>
            </Grid>
          </Border>
        </StackPanel></ScrollViewer>
      </local:PixelBubble>
    </Grid>
    <Image x:Name="Character" Height="330" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,80,4" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="CharacterMouseDown" MouseMove="CharacterMouseMove" MouseLeftButtonUp="CharacterMouseUp" ToolTip="클릭해 대화 · 우클릭해 메뉴 · 드래그해 이동">
      <Image.ContextMenu><ContextMenu>
        <MenuItem Header="대화 입력" Click="ChatClick"/><MenuItem Header="대화 선택" Click="ConversationMenuClick"/><MenuItem Header="새 대화" Click="NewConversationClick"/><MenuItem Header="대화 기록" Click="HistoryClick"/>
        <Separator/><MenuItem x:Name="QuietMenu" Header="조용히"><MenuItem x:Name="QuietState" IsEnabled="False"/><Separator/><MenuItem x:Name="QuietHourMenu" Header="1시간 조용히" Click="QuietHourClick"/><MenuItem x:Name="QuietMorningMenu" Header="내일 아침까지 조용히" Click="QuietMorningClick"/><MenuItem x:Name="QuietOffMenu" Header="조용히 끄기" Click="QuietOffClick"/></MenuItem>
        <Separator/><MenuItem x:Name="FlipMenu" Header="좌우 반전" IsCheckable="True" Click="FlipClick"/><MenuItem Header="설정" Click="SettingsClick"/><MenuItem Header="말풍선 닫기" Click="CloseBubbleClick"/>
        <Separator/><MenuItem Header="숨기기" Click="HideClick"/><MenuItem Header="종료" Click="ExitClick"/>
      </ContextMenu></Image.ContextMenu>
    </Image>
    <Button x:Name="ConnectionNotice" Width="24" Height="24" MinHeight="24" Padding="0" Content="!" FontWeight="Bold" Foreground="#80501D" Background="#FFF5DB" BorderBrush="#B69254" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="220,0,0,24" Visibility="Collapsed" ToolTip="{Binding Text, ElementName=Status}" AutomationProperties.Name="연결 상태 확인" AutomationProperties.HelpText="{Binding Text, ElementName=Status}" Click="SettingsClick"/>
  </Grid>
</Window>
