<Window x:Class="Himari.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="히마리" Width="420" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <Grid x:Name="BubblePanel" Width="300" MaxHeight="360" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="15,0,15,320" UseLayoutRounding="True">
      <Border x:Name="BubbleSurface" Background="#FFFDF8" BorderBrush="#57516F" BorderThickness="3" Margin="0,0,0,14" SnapsToDevicePixels="True"/>
      <Border BorderBrush="#DED7E8" BorderThickness="1" Margin="4,4,4,18" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
      <Path x:Name="BubbleTail" Data="M 0,0 L 24,0 24,4 18,4 18,8 12,8 12,12 6,12 6,4 0,4 Z" Width="24" Height="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Fill="#FFFDF8" Stroke="#57516F" StrokeThickness="2" SnapsToDevicePixels="True"/>
      <ScrollViewer Margin="16,12,16,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Status" Text="연결되지 않음" Visibility="Collapsed"/>
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="⋯" Width="32" Padding="0" FontSize="19" ToolTip="대화 메뉴" AutomationProperties.Name="대화 메뉴" Click="MoreClick" Background="Transparent" BorderThickness="0">
            <Button.ContextMenu><ContextMenu><MenuItem Header="대화 입력" Click="ChatClick"/><MenuItem Header="대화 선택" Click="ConversationMenuClick"/><MenuItem Header="새 대화" Click="NewConversationClick"/><MenuItem Header="대화 기록" Click="HistoryClick"/><MenuItem Header="답변 멈춤" Click="CancelClick"/><Separator/><MenuItem Header="설정" Click="SettingsClick"/><MenuItem Header="말풍선 닫기" Click="CloseBubbleClick"/></ContextMenu></Button.ContextMenu>
          </Button>
          <TextBlock Text="히마리" FontSize="12" FontWeight="SemiBold" Foreground="#71668F" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="140" MinHeight="28"><TextBlock x:Name="Message" Text="안녕하세요, 선생님." TextWrapping="Wrap" FontSize="15" LineHeight="23" Foreground="#34304A"/></ScrollViewer>
        <StackPanel x:Name="ComposerPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0">
          <Expander x:Name="ChatTools" Header="대화 선택" Visibility="Collapsed" Margin="0,0,0,4"><DockPanel><Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="새 대화" Click="NewConversationClick"/><ComboBox x:Name="Conversations" DisplayMemberPath="Title" SelectionChanged="ConversationChanged"/></DockPanel></Expander>
          <TextBox x:Name="Input" MaxLength="64000" MinHeight="46" MaxHeight="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="InputChanged" ToolTip="메시지 입력 · Enter로 보내기, Shift+Enter로 줄바꿈" AutomationProperties.Name="메시지 입력"/>
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Style="{StaticResource PrimaryButton}" Click="SendClick" Margin="8,0,0,0"/>
            <CheckBox x:Name="ScreenOnce" Content="화면 첨부" ToolTip="보내는 순간의 모니터 화면을 첨부합니다."/>
          </DockPanel>
          <TextBlock x:Name="ScreenSharingIndicator" Text="화면 같이 보기 켜짐 · 매번 첨부" Visibility="Collapsed" Foreground="#80501D" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Text, ElementName=Status}" FontSize="11" Foreground="#625E76" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid></ScrollViewer>
    </Grid>
    <Image x:Name="Character" Height="330" VerticalAlignment="Bottom" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="CharacterMouseDown" MouseMove="CharacterMouseMove" MouseLeftButtonUp="CharacterMouseUp" ToolTip="클릭해 대화하거나 드래그해 이동합니다.">
      <Image.ContextMenu><ContextMenu><MenuItem Header="대화 열기" Click="ChatClick"/><MenuItem Header="설정" Click="SettingsClick"/><Separator/><MenuItem Header="숨기기" Click="HideClick"/><MenuItem Header="종료" Click="ExitClick"/></ContextMenu></Image.ContextMenu>
    </Image>
  </Grid>
</Window>
