<Window x:Class="Himari.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="히마리" Width="420" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True">
  <Grid>
    <Grid x:Name="BubblePanel" Width="270" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="15,0,15,320" UseLayoutRounding="True">
      <Border x:Name="BubbleSurface" Background="#FFFDF8" BorderBrush="#57516F" BorderThickness="3" Margin="0,0,0,14" SnapsToDevicePixels="True"/>
      <Border BorderBrush="#DED7E8" BorderThickness="1" Margin="4,4,4,18" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
      <Path x:Name="BubbleTail" Data="M 0,0 L 24,0 24,4 18,4 18,8 12,8 12,12 6,12 6,4 0,4 Z" Width="24" Height="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Fill="#FFFDF8" Stroke="#57516F" StrokeThickness="2" SnapsToDevicePixels="True"/>
      <StackPanel Margin="13,10,13,25">
        <TextBlock x:Name="Status" Text="연결되지 않음" Visibility="Collapsed"/>
        <DockPanel LastChildFill="True">
          <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="⋯" FontSize="17" FontWeight="Bold" Padding="3,0" Margin="5,0,0,0" ToolTip="더보기" Click="MoreClick" Background="Transparent" BorderThickness="0" VerticalAlignment="Top">
            <Button.ContextMenu><ContextMenu><MenuItem Header="대화 입력" Click="ChatClick"/><MenuItem Header="대화 선택" Click="ConversationMenuClick"/><MenuItem Header="새 대화" Click="NewConversationClick"/><MenuItem Header="대화 기록" Click="HistoryClick"/><MenuItem Header="답변 멈춤" Click="CancelClick"/><Separator/><MenuItem Header="설정" Click="SettingsClick"/><MenuItem Header="말풍선 닫기" Click="CloseBubbleClick"/></ContextMenu></Button.ContextMenu>
          </Button>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140"><TextBlock x:Name="Message" Text="안녕하세요, 선생님." TextWrapping="Wrap" FontSize="15" Foreground="#34304A"/></ScrollViewer>
        </DockPanel>
        <StackPanel x:Name="ComposerPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <CheckBox x:Name="ScreenOnce" Content="이번 메시지에 화면 첨부" ToolTip="보내는 순간 화면을 캡처합니다." Margin="0,0,0,4"/>
          <TextBlock x:Name="ScreenSharingIndicator" Text="화면 같이 보기 켜짐" Visibility="Collapsed" Foreground="#88541A" FontSize="11" Margin="0,0,0,4"/>
          <Expander x:Name="ChatTools" Header="대화 선택" Visibility="Collapsed" Margin="0,0,0,4"><DockPanel><Button DockPanel.Dock="Right" Content="새 대화" Click="NewConversationClick"/><ComboBox x:Name="Conversations" DisplayMemberPath="Title" SelectionChanged="ConversationChanged"/></DockPanel></Expander>
          <DockPanel LastChildFill="True"><Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Click="SendClick" Padding="6,3" Margin="5,0,0,0"/><TextBox x:Name="Input" MaxLength="64000" KeyDown="InputKeyDown" TextChanged="InputChanged" ToolTip="메시지 입력"/></DockPanel>
          <TextBlock Text="{Binding Text, ElementName=Status}" FontSize="11" Foreground="#68718B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Image x:Name="Character" Height="330" VerticalAlignment="Bottom" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="CharacterMouseDown" MouseMove="CharacterMouseMove" MouseLeftButtonUp="CharacterMouseUp" ToolTip="클릭해 대화하거나 드래그해 이동합니다.">
      <Image.ContextMenu><ContextMenu><MenuItem Header="대화 열기" Click="ChatClick"/><MenuItem Header="설정" Click="SettingsClick"/><Separator/><MenuItem Header="숨기기" Click="HideClick"/><MenuItem Header="종료" Click="ExitClick"/></ContextMenu></Image.ContextMenu>
    </Image>
  </Grid>
</Window>
