<Window x:Class="Himari.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="히마리" Width="420" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False">
  <Grid>
    <Border VerticalAlignment="Top" Margin="20,10" Background="#F5FFFFFF" CornerRadius="12" Padding="12" MouseLeftButtonDown="DragWindow">
      <StackPanel>
        <TextBlock Text="히마리" FontWeight="Bold" Foreground="#354360"/>
        <TextBlock x:Name="Status" Text="연결되지 않음" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
        <Expander x:Name="Bubble" Header="히마리의 말" IsExpanded="True" Margin="0,8,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160"><TextBlock x:Name="Message" Text="안녕하세요, 선생님." TextWrapping="Wrap" Foreground="#354360"/></ScrollViewer>
        </Expander>
        <StackPanel x:Name="PairPanel" Margin="0,8,0,0">
          <TextBlock Text="서버 HTTPS 주소" FontSize="11"/>
          <TextBox x:Name="ServerAddress" ToolTip="서버 HTTPS 주소" Text="https://"/>
          <TextBlock Text="Web에서 발급한 짝짓기 코드" FontSize="11" Margin="0,4,0,0"/>
          <TextBox x:Name="PairCode" ToolTip="Web에서 발급한 짝짓기 코드" Margin="0,4,0,0"/>
          <Button Content="기기 연결" Click="PairClick" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ChatPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <DockPanel><Button DockPanel.Dock="Right" Content="새 대화" Click="NewConversationClick"/><ComboBox x:Name="Conversations" DisplayMemberPath="Title" SelectionChanged="ConversationChanged"/></DockPanel>
          <TextBox x:Name="Input" Margin="0,4,0,0" MaxLength="64000" KeyDown="InputKeyDown" ToolTip="메시지 입력"/>
          <WrapPanel Margin="0,4,0,0"><Button x:Name="SendButton" Content="보내기" Click="SendClick" Padding="8,3"/><Button Content="멈춤" Click="CancelClick" Padding="8,3" Margin="5,0,0,0"/><Button Content="Web 열기" Click="OpenWebClick" Padding="8,3" Margin="5,0,0,0"/></WrapPanel>
        </StackPanel>
        <WrapPanel Margin="0,8,0,0"><Button Content="가짜 대화" Click="DemoClick" Padding="8,4" Margin="0,0,6,0"/><ComboBox x:Name="MoodSelector" Width="140" SelectionChanged="MoodChanged"/></WrapPanel>
      </StackPanel>
    </Border>
    <Image x:Name="Character" Height="330" VerticalAlignment="Bottom" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="CharacterMouseDown" ToolTip="클릭해 입력하거나 드래그해 이동합니다."/>
  </Grid>
</Window>
