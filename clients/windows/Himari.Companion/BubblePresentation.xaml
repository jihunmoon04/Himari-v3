<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BubbleInk" Color="#453C51"/>
  <SolidColorBrush x:Key="BubbleMuted" Color="#766A82"/>
  <SolidColorBrush x:Key="BubbleLine" Color="#766385"/>
  <SolidColorBrush x:Key="BubbleSeparator" Color="#DED4E9"/>
  <SolidColorBrush x:Key="BubbleHover" Color="#E8DFF4"/>
  <SolidColorBrush x:Key="BubbleAccent" Color="#6C5686"/>
  <SolidColorBrush x:Key="BubbleWarning" Color="#875B2C"/>
  <Style x:Key="BubbleIconButton" TargetType="Button">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="5"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource BubbleMuted}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Face" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource BubbleHover}"/><Setter Property="Foreground" Value="{StaticResource BubbleInk}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource BubbleHover}"/><Setter Property="Foreground" Value="{StaticResource BubbleInk}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#DBCEE9"/></Trigger>
        <Trigger Property="Tag" Value="ready"><Setter TargetName="Face" Property="Background" Value="{StaticResource BubbleAccent}"/><Setter Property="Foreground" Value="#FFFAFF"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="ready"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Face" Property="Background" Value="#5A466F"/></MultiTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.36"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BubbleSendButton" TargetType="Button" BasedOn="{StaticResource BubbleIconButton}">
    <Style.Triggers><Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource BubbleAccent}"/><Setter Property="Foreground" Value="#FFFAFF"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="BubbleTextButton" TargetType="Button" BasedOn="{StaticResource BubbleIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="3,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="BubbleStatusText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource BubbleMuted}"/>
  </Style>
</ResourceDictionary>
