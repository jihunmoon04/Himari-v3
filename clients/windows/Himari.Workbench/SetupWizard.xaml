<Window x:Class="Himari.Workbench.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Himari.Workbench"
        Title="HIMARI 작업 앱 처음 설정" Width="640" Height="780" MinWidth="500" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="#F7F5FA" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" Foreground="#34304A" UseLayoutRounding="True">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="HIMARI 작업 앱 처음 설정" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" Text="작업 콘솔(Web)을 이 창에서 열고, 이 PC의 hub 실행기를 켜고 끕니다."/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="FinishButton" Content="완료" IsDefault="True" MinWidth="80" Margin="0,0,8,0" IsEnabled="False" Click="FinishClick"/>
      <Button Content="취소" IsCancel="True" MinWidth="72"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="1. 서버 주소" Style="{StaticResource Heading}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="열리는지 보기" Margin="6,0,0,0" Click="CheckServerClick"/><TextBox x:Name="ServerAddress" Text="https://" AutomationProperties.Name="서버 주소"/></DockPanel>
          <CheckBox x:Name="DeveloperMode" Content="개발자 모드(http://127.0.0.1·localhost 허용)" Margin="0,8,0,0"/>
          <TextBlock x:Name="ServerResult" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="2. hub 명령" Style="{StaticResource Heading}"/>
          <local:HubFields x:Name="Hub"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="3. 확인과 4. 기기 등록" Style="{StaticResource Heading}"/>
          <TextBlock Style="{StaticResource Hint}" Text="hub 명령으로 runner status --json을 실행합니다. 처음에는 uv가 의존성을 설치하느라 오래 걸릴 수 있습니다."/>
          <Button x:Name="CheckHubButton" Content="hub 확인" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CheckHubClick"/>
          <TextBlock x:Name="HubResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="RegistrationResult" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="5. 연동" Style="{StaticResource Heading}"/>
          <CheckBox x:Name="Linked" Content="앱과 함께 실행기 켜고 끄기(권장)" IsChecked="True"/>
          <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,8" Text="앱을 켜면 실행기도 켜지고, 트레이에서 종료하면 앱이 켠 실행기에만 끄기를 요청합니다."/>
          <CheckBox x:Name="StartAtLogin" Content="Windows에 로그인하면 앱 시작"/>
          <Border Background="#FFF4D6" BorderBrush="#F0DFA8" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Text="실행기를 켜는 것은 이 기기에서 원격 실행을 여는 일입니다. 떠 있는 실행기는 hub 서버가 보내는 작업을 받아, 등록된 프로젝트 폴더에서 에이전트(와 에이전트가 실행하는 프로그램)를 돌립니다. 그 권한은 hub 서버의 인증, 이 기기의 실행기 토큰, 등록된 프로젝트 폴더와 승인 정책이 정합니다. 이 앱이 더하는 것은 이 기기에서 실행기를 켜고 끄는 일뿐입니다."/>
          </Border>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
