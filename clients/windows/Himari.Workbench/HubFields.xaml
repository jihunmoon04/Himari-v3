<UserControl x:Class="Himari.Workbench.HubFields" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Label Content="실행 파일(절대 경로)" Target="{Binding ElementName=Executable}" Padding="0,0,0,4"/>
    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="찾아보기" Margin="6,0,0,0" Click="BrowseExecutable"/><TextBox x:Name="Executable" AutomationProperties.Name="hub 실행 파일"/></DockPanel>
    <Label Content="hub 폴더(pyproject.toml이 있는 곳)" Target="{Binding ElementName=HubFolder}" Padding="0,0,0,4"/>
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="찾아보기" Margin="6,0,0,0" Click="BrowseHubFolder"/><TextBox x:Name="HubFolder" AutomationProperties.Name="hub 폴더"/></DockPanel>
    <TextBlock Text="hub 폴더를 고르면 인자와 작업 폴더를 uv 방식(run --project &lt;hub 폴더&gt; himari-hub)으로 채웁니다." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
    <Label Content="인자(한 줄에 하나, 셸을 거치지 않고 그대로 넘김)" Target="{Binding ElementName=Arguments}" Padding="0,0,0,4"/>
    <TextBox x:Name="Arguments" AcceptsReturn="True" MinLines="3" MaxLines="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" FontFamily="Consolas, Malgun Gothic" AutomationProperties.Name="hub 명령 인자"/>
    <Label Content="작업 폴더" Target="{Binding ElementName=WorkingDirectory}" Padding="0,0,0,4"/>
    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="찾아보기" Margin="6,0,0,0" Click="BrowseWorkingDirectory"/><TextBox x:Name="WorkingDirectory" AutomationProperties.Name="작업 폴더"/></DockPanel>
    <Label Content="hub 홈" Target="{Binding ElementName=HubHome}" Padding="0,0,0,4"/>
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="찾아보기" Margin="6,0,0,0" Click="BrowseHubHome"/><TextBox x:Name="HubHome" AutomationProperties.Name="hub 홈"/></DockPanel>
    <TextBlock Text="앱은 이 hub 홈의 실행기 하나만 관리하고, 실행할 때 HIMARI_HUB_HOME으로 넘깁니다. hub의 토큰은 읽거나 넘기지 않습니다." Style="{StaticResource Hint}"/>
  </StackPanel>
</UserControl>
