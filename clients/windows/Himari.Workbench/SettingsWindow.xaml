<Window x:Class="Himari.Workbench.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Himari.Workbench"
        Title="HIMARI 작업 앱 설정" Width="600" Height="720" MinWidth="480" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="#F7F5FA" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" Foreground="#34304A" UseLayoutRounding="True" ShowInTaskbar="False">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="처음 설정 다시 하기" Margin="0,0,8,0" Click="WizardClick"/>
      <Button Content="저장" IsDefault="True" MinWidth="72" Margin="0,0,8,0" Click="SaveClick"/>
      <Button Content="취소" IsCancel="True" MinWidth="72"/>
    </StackPanel>
    <TextBlock x:Name="Problem" DockPanel.Dock="Bottom" Style="{StaticResource Problem}" Visibility="Collapsed"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="작업 콘솔" Style="{StaticResource Heading}"/>
          <Label Content="서버 주소(https://…)" Target="{Binding ElementName=ServerAddress}" Padding="0,0,0,4"/>
          <TextBox x:Name="ServerAddress" Margin="0,0,0,8" AutomationProperties.Name="서버 주소"/>
          <TextBlock Style="{StaticResource Hint}" Text="인증서 오류는 넘기지 않습니다. 사설 인증서를 쓰는 서버라면 그 인증서를 Windows 인증서 저장소(신뢰할 수 있는 루트)에 넣어야 열립니다."/>
          <CheckBox x:Name="DeveloperMode" Content="개발자 모드(http://127.0.0.1·localhost 주소와 개발자 도구 허용)" Margin="0,10,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="hub 실행기" Style="{StaticResource Heading}"/>
          <local:HubFields x:Name="Hub"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="hub 명령의 실행 파일은 이 앱이 그대로 실행하는 프로그램입니다. 실행 파일이나 hub 홈을 바꾸면 한 번 더 묻고, 앱이 켠 실행기가 떠 있는 동안에는 먼저 끄게 합니다."/>
        </StackPanel></Border>
        <Border Style="{StaticResource Section}"><StackPanel>
          <TextBlock Text="연동" Style="{StaticResource Heading}"/>
          <CheckBox x:Name="Linked" Content="앱과 함께 실행기 켜고 끄기"/>
          <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,8" Text="앱을 켜면 꺼져 있는 실행기를 켜고, 트레이에서 종료하면 앱이 켠 실행기에만 끄기를 요청합니다. 다른 곳에서 켠 실행기는 건드리지 않습니다."/>
          <CheckBox x:Name="StartAtLogin" Content="Windows에 로그인하면 앱 시작"/>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
