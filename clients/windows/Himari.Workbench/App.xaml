<Application x:Class="Himari.Workbench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#6B6485"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2DCEE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Problem" TargetType="TextBlock"><Setter Property="Foreground" Value="#B3261E"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="26"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="4,3"/></Style>
  </Application.Resources>
</Application>
