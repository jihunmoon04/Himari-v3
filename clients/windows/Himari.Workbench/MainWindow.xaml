<Window x:Class="Himari.Workbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HIMARI 작업 콘솔" Width="1280" Height="820" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="#F7F5FA" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" Foreground="#34304A" UseLayoutRounding="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#EFEAF7" BorderBrush="#DDD5EC" BorderThickness="0,0,0,1" Padding="12,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RunnerButton" Content="켜기" MinWidth="64" Margin="8,0,0,0" Click="RunnerClick" AutomationProperties.Name="실행기 켜기 또는 끄기"/>
          <Button x:Name="LogButton" Content="기록" Margin="6,0,0,0" Click="LogClick" ToolTip="runner.log를 기본 편집기로 엽니다"/>
          <Button x:Name="SettingsButton" Content="설정" Margin="6,0,0,0" Click="SettingsClick"/>
        </StackPanel>
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#A7A1B8"/>
        <TextBlock x:Name="StatusText" Text="실행기: 확인 중…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
    <Border x:Name="NoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF4D6" BorderBrush="#F0DFA8" BorderThickness="0,0,0,1" Padding="12,4">
      <TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
    </Border>
    <Grid x:Name="BrowserHost">
      <StackPanel x:Name="Fallback" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
        <TextBlock x:Name="FallbackTitle" Text="WebView2 Runtime이 필요합니다" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="FallbackDetail" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,14"
                   Text="작업 콘솔 창을 보이려면 Microsoft Edge WebView2 Runtime을 설치하세요. 실행기 켜기·끄기(위 상태 줄과 트레이)는 그대로 쓸 수 있습니다."/>
        <Button x:Name="FallbackButton" Content="설치 안내 열기" HorizontalAlignment="Left" Click="FallbackClick"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
